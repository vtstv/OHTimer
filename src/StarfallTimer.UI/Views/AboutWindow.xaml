<Window x:Class="StarfallTimer.UI.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:StarfallTimer.UI.Localization"
        mc:Ignorable="d"
        Title="About — Once Human Event Timer"
        Icon="/Assets/app.ico"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="16"
            Background="#E80D1117"
            BorderBrush="{StaticResource AccentWaitingBrush}"
            BorderThickness="1.5"
            CornerRadius="10"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.8" />
        </Border.Effect>

        <StackPanel>
            <!-- Header Section with Cosmic Badge -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- App Icon -->
                <Border Grid.Column="0"
                        Width="56" Height="56"
                        Background="#1E293B"
                        BorderBrush="{StaticResource AccentWaitingBrush}"
                        BorderThickness="1.5"
                        CornerRadius="28"
                        Margin="0,0,16,0">
                    <TextBlock Text="✦"
                               FontSize="32"
                               Foreground="{StaticResource AccentWaitingBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#00F0FF" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Border>

                <!-- Title & Version Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Once Human — Event Timer"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Border Background="#2000E5FF"
                                BorderBrush="{StaticResource AccentWaitingBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,1"
                                Margin="0,0,8,0">
                            <TextBlock Text="Version 1.1.0"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentWaitingBrush}" />
                        </Border>

                        <Border Background="#20A855F7"
                                BorderBrush="{StaticResource AccentActiveBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,1">
                            <TextBlock Text="Universal Multi-Wheel Engine"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentActiveBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Separator -->
            <Rectangle Height="1" Fill="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

            <!-- Description -->
            <TextBlock Text="A modern, high-precision Windows desktop HUD overlay designed for Once Human. Tracks recurring world event cycles including Gravity Abyss (Starfall Inversion) and Cargo Scramble with zero-drift game time synchronization, procedural audio alerts, and click-through gameplay mode."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12.5"
                       LineHeight="18"
                       Margin="0,0,0,16" />

            <!-- Key Features Grid -->
            <Border Background="#141B26"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="⚡ Universal Multi-Wheel Presets" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11.5" Margin="0,2" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="🎯 1-Click Game Sync (Zero Drift)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11.5" Margin="0,2" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="🔒 Click-Through Mode (Pass clicks)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11.5" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="🔊 Procedural Chime Alerts" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11.5" Margin="0,2" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="🌐 English, German &amp; Russian" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11.5" Margin="0,2" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="⚙️ Frameless Always-On-Top HUD" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11.5" Margin="0,2" />
                </Grid>
            </Border>

            <!-- Author & Links -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Author: " Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                <TextBlock Grid.Column="1" FontSize="12">
                    <Bold><Run Text="Murr" Foreground="{StaticResource TextPrimaryBrush}" /></Bold>
                    <Run Text=" — " Foreground="{StaticResource TextMutedBrush}" />
                    <Hyperlink NavigateUri="https://github.com/vtstv" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{StaticResource AccentWaitingBrush}">
                        https://github.com/vtstv
                    </Hyperlink>
                </TextBlock>
            </Grid>

            <!-- Bottom Action -->
            <Button Style="{StaticResource PrimaryAccentButtonStyle}"
                    Content="Close"
                    HorizontalAlignment="Right"
                    Width="100"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Border>
</Window>
