<Window x:Class="StarfallTimer.UI.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:StarfallTimer.UI.Localization"
        xmlns:controls="clr-namespace:StarfallTimer.UI.Controls"
        xmlns:vm="clr-namespace:StarfallTimer.UI.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:OverlayViewModel}"
        mc:Ignorable="d"
        Title="Once Human - Event Timer Overlay"
        Icon="/Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding AlwaysOnTop}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Opacity="{Binding Opacity}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="12"
            Background="#E80D1117"
            BorderBrush="{Binding StatusColorHex, FallbackValue='#00F0FF'}"
            BorderThickness="1.5"
            CornerRadius="10">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
        </Border.LayoutTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.75" />
            </Border.Effect>

            <Grid Width="230" Margin="12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Header: Badge + Window Controls -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status Badge -->
                    <Border Grid.Column="0" 
                            HorizontalAlignment="Left"
                            Background="#22FFFFFF"
                            BorderBrush="{Binding StatusColorHex}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" 
                                     Fill="{Binding StatusColorHex}" 
                                     Margin="0,0,5,0" />
                            <TextBlock Text="{Binding PhaseBadgeText}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="Bold"
                                       FontSize="10" />
                        </StackPanel>
                    </Border>

                    <!-- Quick Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- About Button -->
                        <Button Style="{StaticResource HudIconButtonStyle}"
                                Command="{Binding OpenAboutCommand}"
                                ToolTip="{loc:Loc HUD_About}"
                                Margin="0,0,2,0">
                            <TextBlock Text="ℹ" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>

                        <!-- Lock Button -->
                        <Button Style="{StaticResource HudIconButtonStyle}"
                                Command="{Binding ToggleLockCommand}"
                                ToolTip="{loc:Loc HUD_Locked}">
                            <TextBlock FontSize="11" 
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="🔓" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                <Setter Property="Text" Value="🔒" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentWaitingBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <!-- Settings Button -->
                        <Button Style="{StaticResource HudIconButtonStyle}"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip="{loc:Loc HUD_Settings}"
                                Margin="2,0,0,0">
                            <TextBlock Text="⚙" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>

                        <!-- Close / Hide Button -->
                        <Button Style="{StaticResource HudIconButtonStyle}"
                                Command="{Binding HideOverlayCommand}"
                                ToolTip="{loc:Loc HUD_Close}"
                                Margin="2,0,0,0">
                            <TextBlock Text="✕" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Center Section: Countdown Display & Circular Progress -->
                <Grid Grid.Row="1" Margin="0,8,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Circular Progress Ring -->
                    <controls:CircularTimerProgress Grid.Column="0" 
                                                   Width="52" Height="52"
                                                   Progress="{Binding ProgressRatio}"
                                                   Margin="0,0,10,0" />

                    <!-- Countdown Text & Active Event -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveEventName}"
                                   Foreground="{Binding StatusColorHex}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,2" />

                        <TextBlock Text="{Binding PhaseDescriptionText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold" />

                        <TextBlock Text="{Binding FormattedRemaining}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Consolas, Segoe UI Mono, monospace"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Margin="0,1,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{Binding StatusColorHex}" BlurRadius="6" ShadowDepth="0" Opacity="0.6" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Linear Progress Bar -->
                <ProgressBar Grid.Row="2" 
                             Height="3" 
                             Minimum="0" Maximum="1" 
                             Value="{Binding ProgressRatio}"
                             Foreground="{Binding StatusColorHex}"
                             Background="#1F2937"
                             BorderThickness="0"
                             Margin="0,2,0,6" />

                <!-- Footer: Drift Sync & Next Event Local Time -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding DriftSyncText}"
                               Foreground="{StaticResource AccentWaitingBrush}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Left" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding NextEventTimeText}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="10"
                               HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Border>
</Window>
