<UserControl x:Class="OnceHumanEventTimer.UI.Controls.CircularTimerProgress"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="120">
    <Grid>
        <!-- Background Track -->
        <Ellipse Stroke="#263140" 
                 StrokeThickness="6" 
                 Margin="6" />

        <!-- Glowing Progress Arc -->
        <Path x:Name="ArcPath"
              Stroke="{Binding StatusColorHex, FallbackValue='#00E5FF'}"
              StrokeThickness="6"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Margin="6">
            <Path.Effect>
                <DropShadowEffect Color="{Binding StatusColorHex, FallbackValue='#00E5FF'}" 
                                  BlurRadius="8" 
                                  ShadowDepth="0" 
                                  Opacity="0.8" />
            </Path.Effect>
        </Path>
    </Grid>
</UserControl>
