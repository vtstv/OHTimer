<Window x:Class="OnceHumanEventTimer.UI.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:OnceHumanEventTimer.UI.Localization"
        xmlns:vm="clr-namespace:OnceHumanEventTimer.UI.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:OnboardingViewModel}"
        mc:Ignorable="d"
        Title="{loc:Loc Onboarding_WindowTitle}"
        Width="580" Height="430"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#F20B0F17"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="10"
            Padding="22,18">
        <Border.Effect>
            <DropShadowEffect Color="#00F0FF" BlurRadius="20" ShadowDepth="0" Opacity="0.18" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✦ " Foreground="{StaticResource AccentWaitingBrush}" FontSize="12" />
                    <TextBlock Text="{loc:Loc Onboarding_Header}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding StepIndicatorText}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentWaitingBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />

                <Button Grid.Column="2"
                        Command="{Binding SkipCommand}"
                        Style="{StaticResource HudIconButtonStyle}"
                        ToolTip="{loc:Loc Onboarding_Skip}"
                        Padding="6,2">
                    <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>
            </Grid>

            <!-- Step Content -->
            <Grid Grid.Row="1" Margin="4,0,4,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding StepIcon}" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StepTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentWaitingBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding StepSubtitle}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="34,0,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,10">
                    <TextBlock Text="{Binding StepDescription}"
                               FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="18" />
                </ScrollViewer>

                <!-- Tip Card -->
                <Border Grid.Row="2"
                        Background="#141D2B"
                        BorderBrush="#2A384C"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💡" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StepTip}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="470"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Navigation Bar -->
            <Grid Grid.Row="2" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Skip -->
                <Button Grid.Column="0"
                        Command="{Binding SkipCommand}"
                        Style="{StaticResource ModernDarkButtonStyle}"
                        Content="{loc:Loc Onboarding_Skip}"
                        Padding="12,6" FontSize="11" />

                <!-- Back -->
                <Button Grid.Column="2"
                        Command="{Binding PreviousCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        Style="{StaticResource ModernDarkButtonStyle}"
                        Content="{loc:Loc Onboarding_Back}"
                        Padding="14,6" FontSize="11"
                        Margin="0,0,8,0" />

                <!-- Next or Finish -->
                <Button Grid.Column="3"
                        Command="{Binding NextCommand}"
                        Padding="18,6" FontSize="11" FontWeight="Bold">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryAccentButtonStyle}">
                            <Setter Property="Content" Value="{loc:Loc Onboarding_Next}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                    <Setter Property="Content" Value="{loc:Loc Onboarding_Finish}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
