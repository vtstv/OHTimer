<Window x:Class="OnceHumanEventTimer.UI.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:OnceHumanEventTimer.UI.Localization"
        xmlns:controls="clr-namespace:OnceHumanEventTimer.UI.Controls"
        xmlns:converters="clr-namespace:OnceHumanEventTimer.UI.Converters"
        xmlns:vm="clr-namespace:OnceHumanEventTimer.UI.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:OverlayViewModel}"
        mc:Ignorable="d"
        Title="Once Human - Event Timer Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding AlwaysOnTop}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Opacity="{Binding Opacity}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="12" CornerRadius="10">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#E80D1117" />
                <Setter Property="BorderBrush" Value="{Binding StatusColorHex, FallbackValue='#00F0FF'}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.75" />
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowBackground}" Value="False">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Effect" Value="{x:Null}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ShowBorder}" Value="False">
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
        </Border.LayoutTransform>

        <Grid>
            <!-- 1. FULL HUD MODE -->
            <Grid Width="240" Margin="12,10" Visibility="{Binding CompactMode, Converter={StaticResource InvBoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Full Mode Header -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status Badge -->
                    <Border Grid.Column="0" 
                            HorizontalAlignment="Left"
                            Background="#22FFFFFF"
                            BorderBrush="{Binding StatusColorHex}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" 
                                     Fill="{Binding StatusColorHex}" 
                                     Margin="0,0,5,0" />
                            <TextBlock Text="{Binding PhaseBadgeText}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="Bold"
                                       FontSize="10" />
                        </StackPanel>
                    </Border>

                    <!-- Header Quick Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Compact Mode Toggle -->
                        <Button Style="{StaticResource HudIconButtonStyle}"
                                Command="{Binding ToggleCompactModeCommand}"
                                ToolTip="Compact Mode (🗗)"
                                Margin="0,0,2,0">
                            <TextBlock Text="🗗" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>

                        <!-- Lock Button -->
                        <Button Style="{StaticResource HudIconButtonStyle}"
                                Command="{Binding ToggleLockCommand}"
                                ToolTip="{loc:Loc HUD_Locked}">
                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="🔓" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                <Setter Property="Text" Value="🔒" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentWaitingBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <!-- Settings Button -->
                        <Button Style="{StaticResource HudIconButtonStyle}"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip="{loc:Loc HUD_Settings}"
                                Margin="2,0,0,0">
                            <TextBlock Text="⚙" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>

                        <!-- Hide Button -->
                        <Button Style="{StaticResource HudIconButtonStyle}"
                                Command="{Binding HideOverlayCommand}"
                                ToolTip="{loc:Loc HUD_Close}"
                                Margin="2,0,0,0">
                            <TextBlock Text="✕" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Full Mode Body -->
                <Grid Grid.Row="1">
                    <!-- Single-Timer View (when not multi-timer) -->
                    <StackPanel Visibility="{Binding IsMultiTimer, Converter={StaticResource InvBoolToVis}}">
                        <!-- Circular Progress & Countdown -->
                        <Grid Margin="0,4,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <controls:CircularTimerProgress Grid.Column="0" 
                                                           Width="52" Height="52"
                                                           Progress="{Binding ProgressRatio}"
                                                           Margin="0,0,10,0"
                                                           Visibility="{Binding ShowProgressRing, Converter={StaticResource BoolToVis}}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveEventName}"
                                           Foreground="{Binding StatusColorHex}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,2" />

                                <TextBlock Text="{Binding PhaseDescriptionText}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="9"
                                           FontWeight="SemiBold" />

                                <TextBlock Text="{Binding FormattedRemaining}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="Consolas, Segoe UI Mono, monospace"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Margin="0,1,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="{Binding StatusColorHex}" BlurRadius="6" ShadowDepth="0" Opacity="0.6" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- Linear Progress Bar -->
                        <ProgressBar Height="3" 
                                     Minimum="0" Maximum="1" 
                                     Value="{Binding ProgressRatio}"
                                     Foreground="{Binding StatusColorHex}"
                                     Background="#1F2937"
                                     BorderThickness="0"
                                     Margin="0,2,0,6"
                                     Visibility="{Binding ShowProgressRing, Converter={StaticResource BoolToVis}}" />

                        <!-- Footer -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding DriftSyncText}"
                                       Foreground="{StaticResource AccentWaitingBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Left" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding NextEventTimeText}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       Visibility="{Binding ShowNextEventTime, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </StackPanel>

                    <!-- Multi-Timer Stack View (when multiple timers enabled) -->
                    <ItemsControl ItemsSource="{Binding ActiveTimers}"
                                 Visibility="{Binding IsMultiTimer, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" CornerRadius="6" Padding="8,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#121824" />
                                            <Setter Property="BorderBrush" Value="{Binding StatusColorHex}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.ShowBackground, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.ShowBorder, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Card Header -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{Binding StatusColorHex}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="10.5" Foreground="{Binding StatusColorHex}" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding PhaseBadgeText}" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Grid>

                                        <!-- Card Body -->
                                        <Grid Grid.Row="1" Margin="0,4,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <controls:CircularTimerProgress Grid.Column="0" Width="32" Height="32" Progress="{Binding ProgressRatio}" Margin="0,0,8,0"
                                                                           Visibility="{Binding DataContext.ShowProgressRing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PhaseDescriptionText}" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding FormattedRemaining}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontFamily="Consolas, Segoe UI Mono, monospace"
                                                           FontSize="18"
                                                           FontWeight="Bold" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding NextEventTimeText}" FontSize="8" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom"
                                                       Visibility="{Binding DataContext.ShowNextEventTime, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                        </Grid>

                                        <!-- Card Linear Bar -->
                                        <ProgressBar Grid.Row="2" Height="2" Minimum="0" Maximum="1" Value="{Binding ProgressRatio}" Foreground="{Binding StatusColorHex}" Background="#1F2937" BorderThickness="0" Margin="0,2,0,0"
                                                     Visibility="{Binding DataContext.ShowProgressRing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>

            <!-- 2. COMPACT MINI-HUD MODE (Floating Pill) -->
            <Grid Margin="10,6" Visibility="{Binding CompactMode, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Compact Header / Controls Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="MINI HUD" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Restore Full HUD -->
                        <Button Style="{StaticResource HudIconButtonStyle}"
                                Command="{Binding ToggleCompactModeCommand}"
                                ToolTip="Full HUD (🗖)"
                                Margin="0,0,2,0">
                            <TextBlock Text="🗖" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>

                        <!-- Settings Button -->
                        <Button Style="{StaticResource HudIconButtonStyle}"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip="{loc:Loc HUD_Settings}"
                                Margin="2,0,0,0">
                            <TextBlock Text="⚙" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>

                        <!-- Hide Button -->
                        <Button Style="{StaticResource HudIconButtonStyle}"
                                Command="{Binding HideOverlayCommand}"
                                ToolTip="{loc:Loc HUD_Close}"
                                Margin="2,0,0,0">
                            <TextBlock Text="✕" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Compact Single Timer View -->
                <Grid Grid.Row="1" Visibility="{Binding IsMultiTimer, Converter={StaticResource InvBoolToVis}}" Margin="2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Event Badge -->
                    <Border Grid.Column="0"
                            Background="#22FFFFFF"
                            BorderBrush="{Binding StatusColorHex}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{Binding StatusColorHex}" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PhaseBadgeText}" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Large Remaining Countdown -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding FormattedRemaining}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Consolas, Segoe UI Mono, monospace"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{Binding StatusColorHex}" BlurRadius="6" ShadowDepth="0" Opacity="0.7" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>

                <!-- Compact Multi-Timer View (Clean Stacked Rows) -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding ActiveTimers}"
                             Visibility="{Binding IsMultiTimer, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{Binding StatusColorHex}" Margin="0,0,6,0" VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="10"
                                           Foreground="{Binding StatusColorHex}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="110"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding FormattedRemaining}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="Consolas, Segoe UI Mono, monospace"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Border>
</Window>
