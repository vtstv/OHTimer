<Window x:Class="OnceHumanEventTimer.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:OnceHumanEventTimer.UI.Localization"
        xmlns:vm="clr-namespace:OnceHumanEventTimer.UI.ViewModels"
        xmlns:controls="clr-namespace:OnceHumanEventTimer.UI.Controls"
        xmlns:converters="clr-namespace:OnceHumanEventTimer.UI.Converters"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        mc:Ignorable="d"
        Title="{loc:Loc Settings_Title}"
        Width="900" Height="750"
        MinWidth="860" MinHeight="730"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/ScrollBars.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#1E293B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom Dark Titlebar -->
            <Grid Grid.Row="0" Background="#0E121A">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Title & Icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="pack://application:,,,/Assets/app.ico" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Once Human: Event Timer — Settings"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right Window Control Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimize">
                        <TextBlock Text="—" FontSize="11" Foreground="#94A3B8" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click" ToolTip="Maximize">
                        <TextBlock Text="▢" FontSize="12" Foreground="#94A3B8" />
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}" Click="CloseButton_Click" ToolTip="Close">
                        <TextBlock Text="✕" FontSize="11" Foreground="#94A3B8" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Tab Content -->
            <Grid Grid.Row="1" Margin="14,10,14,0">
                <TabControl Background="Transparent" BorderBrush="{StaticResource BorderDarkBrush}">
                    <!-- Tab 1: Events & Presets (Universal Multi-Wheel Engine) -->
                    <TabItem Header="{loc:Loc Settings_TabEvents}">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Event Presets List & Controls -->
                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ListBox Grid.Row="0"
                                         ItemsSource="{Binding Events}"
                                         SelectedItem="{Binding SelectedEvent}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          Style="{StaticResource ModernCheckBoxStyle}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0"
                                                          ToolTip="{loc:Loc Settings_EventEnabled}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding ColorHex}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="200" Margin="13,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Reordering controls -->
                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Command="{Binding MoveEventToTopCommand}"
                                            IsEnabled="{Binding CanMoveSelectedEventUp}"
                                            Style="{StaticResource ModernDarkButtonStyle}"
                                            Content="{loc:Loc Settings_MoveTop}"
                                            Padding="2,4" FontSize="10" Margin="0,0,2,0"
                                            ToolTip="{loc:Loc Settings_MoveTop}" />
                                    <Button Grid.Column="1"
                                            Command="{Binding MoveEventUpCommand}"
                                            IsEnabled="{Binding CanMoveSelectedEventUp}"
                                            Style="{StaticResource ModernDarkButtonStyle}"
                                            Content="▲"
                                            Padding="2,4" FontSize="10" Margin="2,0,2,0"
                                            ToolTip="{loc:Loc Settings_MoveUp}" />
                                    <Button Grid.Column="2"
                                            Command="{Binding MoveEventDownCommand}"
                                            IsEnabled="{Binding CanMoveSelectedEventDown}"
                                            Style="{StaticResource ModernDarkButtonStyle}"
                                            Content="▼"
                                            Padding="2,4" FontSize="10" Margin="2,0,0,0"
                                            ToolTip="{loc:Loc Settings_MoveDown}" />
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Top row: Add, Duplicate and Delete -->
                                    <Button Grid.Row="0" Grid.Column="0"
                                            Command="{Binding AddEventCommand}"
                                            Style="{StaticResource ModernDarkButtonStyle}"
                                            Content="{loc:Loc Settings_AddEvent}"
                                            Padding="2,6" FontSize="10.5" Margin="0,0,2,4"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Row="0" Grid.Column="1"
                                            Command="{Binding DuplicateEventCommand}"
                                            IsEnabled="{Binding CanDuplicateEvent}"
                                            Style="{StaticResource ModernDarkButtonStyle}"
                                            Content="{loc:Loc Settings_DuplicateEvent}"
                                            Padding="2,6" FontSize="10.5" Margin="2,0,2,4"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Row="0" Grid.Column="2"
                                            Command="{Binding DeleteEventCommand}"
                                            Style="{StaticResource DangerDarkButtonStyle}"
                                            Content="{loc:Loc Settings_DeleteEvent}"
                                            Padding="2,6" FontSize="10.5" Margin="2,0,0,4"
                                            HorizontalAlignment="Stretch" />

                                    <!-- Bottom row: Full-width Restore Presets button -->
                                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                            Command="{Binding RestoreDefaultPresetsCommand}"
                                            Style="{StaticResource ModernDarkButtonStyle}"
                                            Content="{loc:Loc Settings_RestorePresets}"
                                            Padding="4,6" FontSize="11" Margin="0,2,0,0"
                                            HorizontalAlignment="Stretch" />
                                </Grid>
                            </Grid>

                            <!-- Right: Selected Event Details & Game Sync -->
                            <Grid Grid.Column="1" Margin="6,0,6,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Sticky Top Header: Active Status / Action -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedEventName}"
                                                   FontSize="13.5"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentWaitingBrush}" />
                                        <TextBlock Text="Configure timing rules, colors, audio, and drift offset."
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>

                                    <!-- If Active: Show green active badge; If not active: Show 'Set as Active' button -->
                                    <Border Grid.Column="1"
                                            Background="#2010B981"
                                            BorderBrush="#10B981"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,4"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsSelectedEventActive, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="✔ Active Event" Foreground="#10B981" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                    <Button Grid.Column="1"
                                            Command="{Binding SetActiveEventCommand}"
                                            Style="{StaticResource PrimaryAccentButtonStyle}"
                                            Content="Set as Active"
                                            Padding="10,4"
                                            FontSize="11"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsSelectedEventActive, Converter={StaticResource InvBoolToVis}}" />
                                </Grid>

                                <Rectangle Grid.Row="0" Height="1" Fill="{StaticResource BorderDarkBrush}" VerticalAlignment="Bottom" />

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                    <StackPanel Margin="0,0,6,0">
                                        <!-- Enable in Multi-Timer HUD -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{loc:Loc Settings_EventEnabled}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                            <CheckBox Grid.Column="1" IsChecked="{Binding SelectedEventIsEnabled, Mode=TwoWay}" Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" />
                                        </Grid>

                                    <!-- Event Configuration Fields -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Settings_EventName}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedEventName, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Settings_CycleMinutes}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedEventCycleMinutes, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Settings_StartTime}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox Width="36" Text="{Binding SelectedEventStartHour, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" ToolTip="Hour (0-23)" />
                                            <TextBlock Text=":" VerticalAlignment="Center" Margin="3,0" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" />
                                            <TextBox Width="36" Text="{Binding SelectedEventStartMinute, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" ToolTip="Minute (0-59)" />
                                            <TextBlock Text=":" VerticalAlignment="Center" Margin="3,0" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" />
                                            <TextBox Width="36" Text="{Binding SelectedEventStartSecond, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" ToolTip="Second (0-59)" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Calibrate Event Start from In-Game Countdown -->
                                    <Border Background="#141D2B"
                                            BorderBrush="#2A384C"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,6"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Settings_CalibrateStart_Title}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       Foreground="{StaticResource AccentWaitingBrush}"
                                                       Margin="0,0,0,2" />
                                            <TextBlock Text="{loc:Loc Settings_CalibrateStart_Desc}"
                                                       FontSize="9.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding EventRemainingInput, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,6,0"
                                                         VerticalContentAlignment="Center"
                                                         ToolTip="e.g. 1h 3m 29s, 3h 55m, 2 h 29 m 4 s, 01:03:29" />
                                                <Button Grid.Column="1"
                                                        Command="{Binding CalibrateEventStartCommand}"
                                                        Style="{StaticResource PrimaryAccentButtonStyle}"
                                                        Content="{loc:Loc Settings_CalibrateStart_Button}"
                                                        Padding="10,3"
                                                        FontSize="11" />
                                            </Grid>
                                            <TextBlock Text="{Binding CalibrateFeedbackMessage}"
                                                       Foreground="#22C55E"
                                                       FontWeight="SemiBold"
                                                       FontSize="10"
                                                       Margin="0,4,0,0"
                                                       Visibility="{Binding ShowCalibrateFeedback, Converter={StaticResource BoolToVis}}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Settings_DurationMinutes}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedEventDurationMinutes, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Settings_TimeOffset}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedEventTimeOffsetSeconds, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                                    </Grid>

                                    <!-- Visual Accent Color Picker & Hex Input -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Settings_EventColor}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding PickEventColorCommand}" 
                                                    Style="{StaticResource ModernDarkButtonStyle}"
                                                    Padding="8,4" Margin="0,0,6,0" Cursor="Hand"
                                                    ToolTip="Choose custom color from palette">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="16" Height="16" Background="{Binding SelectedEventColorHex, FallbackValue='#00F0FF', TargetNullValue='#00F0FF'}" CornerRadius="3" BorderBrush="#334155" BorderThickness="1" Margin="0,0,6,0" />
                                                    <TextBlock Text="🎨 " FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SelectedEventColorHex}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <TextBox Width="75" Text="{Binding SelectedEventColorHex, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Per-Event Audio Preset & Custom File -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Settings_EventSound}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox Width="145"
                                                      ItemsSource="{Binding AvailableSoundPresets}"
                                                      SelectedValuePath="Preset"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValue="{Binding SelectedEventSoundPreset}"
                                                      Validation.ErrorTemplate="{x:Null}"
                                                      Margin="0,0,4,0" />
                                            <Button Command="{Binding PreviewEventSoundCommand}" Style="{StaticResource ModernDarkButtonStyle}" Content="{loc:Loc Settings_PreviewSound}" Padding="6,2" FontSize="10" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Event Custom Sound File (when Custom preset is selected) -->
                                    <Grid Margin="0,0,0,8" Visibility="{Binding IsSelectedEventCustomSound, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Settings_CustomSound}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox Width="140" Text="{Binding SelectedEventCustomSoundPath}" IsReadOnly="True" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="{Binding SelectedEventCustomSoundPath}" />
                                            <Button Command="{Binding BrowseEventSoundCommand}" Style="{StaticResource ModernDarkButtonStyle}" Content="{loc:Loc Settings_Browse}" Padding="6,2" FontSize="10" Margin="0,0,3,0" />
                                            <Button Command="{Binding ClearEventSoundCommand}" Style="{StaticResource DangerDarkButtonStyle}" Content="{loc:Loc Settings_Clear}" Padding="6,2" FontSize="10" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Upcoming Visibility Filter Card -->
                                    <Border Background="#141D2B"
                                            BorderBrush="#2A384C"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,6"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding SelectedEventShowOnlyWhenUpcoming, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="{loc:Loc Settings_ShowOnlyWhenUpcoming}"
                                                      FontSize="11"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      Cursor="Hand" />
                                            <Grid Margin="22,6,0,0" Visibility="{Binding SelectedEventShowOnlyWhenUpcoming, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="65" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc Settings_UpcomingThreshold}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="10" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding SelectedEventUpcomingThresholdMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                         HorizontalContentAlignment="Center"
                                                         FontSize="11" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Event Notifications Options Card (Start & Mid-Event Boss Portal) -->
                                    <Border Background="#141D2B"
                                            BorderBrush="#2A384C"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,6"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding SelectedEventAlertOnStart, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="{loc:Loc Settings_AlertOnStart}"
                                                      FontSize="11"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      Cursor="Hand"
                                                      Margin="0,0,0,6" />
                                            <CheckBox IsChecked="{Binding SelectedEventEnableExtraAlert, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="{loc:Loc Settings_EnableExtraAlert}"
                                                      FontSize="11"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      Cursor="Hand" />
                                            <Grid Margin="22,6,0,0" Visibility="{Binding SelectedEventEnableExtraAlert, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="65" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc Settings_ExtraAlertMinutes}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="10" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding SelectedEventExtraAlertMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                         HorizontalContentAlignment="Center"
                                                         FontSize="11" />
                                            </Grid>
                                            <CheckBox IsChecked="{Binding SelectedEventCountdownToBoss, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="{loc:Loc Settings_CountdownToBoss}"
                                                      FontSize="11"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      Cursor="Hand"
                                                      Margin="22,6,0,0"
                                                      Visibility="{Binding SelectedEventEnableExtraAlert, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>


                                </StackPanel>
                            </ScrollViewer>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Tab 1: Alerts & Audio -->
                    <TabItem Header="{loc:Loc Settings_TabNotifications}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <CheckBox Content="{loc:Loc Settings_PlaySound}" IsChecked="{Binding PlayAlertSound}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="{loc:Loc Settings_PauseAlerts}" IsChecked="{Binding AreAlertsPaused}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="{loc:Loc Settings_PlayOnStart}" IsChecked="{Binding PlayOnEventStart}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="{loc:Loc Settings_ShowToast}" IsChecked="{Binding ShowToastAlert}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Settings_Volume}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Volume}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Settings_AlertBeforeStart}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding AlertMinutesBefore, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Settings_AlertBeforeEnd}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding AlertMinutesBeforeEnd, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                                </Grid>

                                <!-- Default Alert Sound Preset -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Settings_DefaultSound}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox Width="160"
                                                  ItemsSource="{Binding AvailableSoundPresets}"
                                                  SelectedValuePath="Preset"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValue="{Binding AlertSoundPreset}"
                                                  Validation.ErrorTemplate="{x:Null}"
                                                  Margin="0,0,6,0" />
                                        <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding PreviewAlertSoundCommand}" Content="{loc:Loc Settings_PreviewSound}" Padding="8,4" FontSize="11" />
                                    </StackPanel>
                                </Grid>

                                <!-- Global Custom Audio (when Custom preset is selected) -->
                                <StackPanel Margin="0,0,0,12" Visibility="{Binding IsCustomAlertSound, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:Loc Settings_CustomSound}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding CustomSoundPath}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding BrowseSoundCommand}" Content="{loc:Loc Settings_Browse}" Margin="8,0,0,0" />
                                    </Grid>
                                </StackPanel>

                                <!-- Game Server Skew Calibration Card -->
                                <Border Background="#141D2B"
                                        BorderBrush="#2A384C"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Settings_SyncToGame}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="{StaticResource AccentWaitingBrush}" />

                                        <TextBlock Text="{loc:Loc Settings_SyncDesc}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,8" />

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{loc:Loc Settings_GameRemaining}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="11" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding GameRemainingInput, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalContentAlignment="Center"
                                                     Margin="0,0,6,0" />
                                            <Button Grid.Column="2"
                                                    Command="{Binding SyncToGameCommand}"
                                                    Style="{StaticResource PrimaryAccentButtonStyle}"
                                                    Content="{loc:Loc Settings_SyncButton}"
                                                    Padding="12,3"
                                                    FontSize="11" />
                                        </Grid>

                                        <!-- Quick Nudge Buttons -->
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="Nudge: " Foreground="{StaticResource TextMutedBrush}" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <Button Content="-5s" Command="{Binding NudgeOffsetCommand}" CommandParameter="-5" Style="{StaticResource ModernDarkButtonStyle}" Padding="6,2" FontSize="9.5" Margin="0,0,3,0" />
                                            <Button Content="-1s" Command="{Binding NudgeOffsetCommand}" CommandParameter="-1" Style="{StaticResource ModernDarkButtonStyle}" Padding="6,2" FontSize="9.5" Margin="0,0,3,0" />
                                            <Button Content="+1s" Command="{Binding NudgeOffsetCommand}" CommandParameter="1" Style="{StaticResource ModernDarkButtonStyle}" Padding="6,2" FontSize="9.5" Margin="0,0,3,0" />
                                            <Button Content="+5s" Command="{Binding NudgeOffsetCommand}" CommandParameter="5" Style="{StaticResource ModernDarkButtonStyle}" Padding="6,2" FontSize="9.5" Margin="0,0,3,0" />
                                            <Button Content="0s" Command="{Binding NudgeOffsetCommand}" CommandParameter="0" Style="{StaticResource ModernDarkButtonStyle}" Padding="6,2" FontSize="9.5" />
                                        </StackPanel>

                                        <!-- Feedback notification -->
                                        <TextBlock Text="{Binding SyncFeedbackMessage}"
                                                   Foreground="#22C55E"
                                                   FontWeight="SemiBold"
                                                   FontSize="10.5"
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding ShowSyncFeedback, Converter={StaticResource BoolToVis}}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Boss Respawn Timer -->
                    <TabItem Header="{loc:Loc Settings_TabBossTimer}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="16,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Duration & Activation -->
                                <StackPanel Grid.Column="0">
                                    <!-- Card 1: Duration & Target Boss -->
                                    <Border Background="#141D2B" BorderBrush="#2A384C" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc BossTimer_CardDuration}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource AccentWaitingBrush}" Margin="0,0,0,10" />

                                            <!-- Boss Name Input -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="170" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc BossTimer_BossName}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                <TextBox Grid.Column="1" Text="{Binding BossTimerName, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>

                                            <!-- Minutes and Seconds Inputs -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc BossTimer_DurationMinutes}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBox Width="48" Text="{Binding BossTimerMinutes, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="{loc:Loc BossTimer_DurationSeconds}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,6,0" />
                                                    <TextBox Width="48" Text="{Binding BossTimerSeconds, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Quick Presets -->
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc BossTimer_QuickPresets}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,8,0" />
                                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding SetBossPresetCommand}" CommandParameter="3" Content="3 min" Padding="7,3" FontSize="10.5" Margin="0,0,4,4" />
                                                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding SetBossPresetCommand}" CommandParameter="5" Content="5 min" Padding="7,3" FontSize="10.5" Margin="0,0,4,4" />
                                                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding SetBossPresetCommand}" CommandParameter="10" Content="10 min" Padding="7,3" FontSize="10.5" Margin="0,0,4,4" />
                                                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding SetBossPresetCommand}" CommandParameter="15" Content="15 min" Padding="7,3" FontSize="10.5" Margin="0,0,4,4" />
                                                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding SetBossPresetCommand}" CommandParameter="20" Content="20 min" Padding="7,3" FontSize="10.5" Margin="0,0,4,4" />
                                                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding SetBossPresetCommand}" CommandParameter="30" Content="30 min" Padding="7,3" FontSize="10.5" Margin="0,0,4,4" />
                                                </WrapPanel>
                                            </Grid>

                                            <!-- Start / Stop Actions -->
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Command="{Binding StartBossTimerCommand}"
                                                        Style="{StaticResource PrimaryAccentButtonStyle}"
                                                        Content="{loc:Loc BossTimer_StartAction}"
                                                        Margin="0,0,4,0" Padding="8,4" FontSize="11" />
                                                <Button Grid.Column="1"
                                                        Command="{Binding StopBossTimerCommand}"
                                                        Style="{StaticResource DangerDarkButtonStyle}"
                                                        Content="{loc:Loc BossTimer_StopAction}"
                                                        Margin="4,0,0,0" Padding="8,4" FontSize="11" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 2: Activation & Hotkey -->
                                    <Border Background="#141D2B" BorderBrush="#2A384C" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc BossTimer_CardActivation}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource AccentWaitingBrush}" Margin="0,0,0,10" />

                                            <CheckBox Content="{loc:Loc BossTimer_Enable}" IsChecked="{Binding BossTimerEnabled}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />

                                            <!-- Hotkey Recorder Row -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc BossTimer_Hotkey}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <controls:HotkeyBox Width="120" Height="28" Hotkey="{Binding BossTimerHotkey, Mode=TwoWay}" PromptText="{loc:Loc BossTimer_HotkeyRecorderPrompt}" Margin="0,0,6,0" />
                                                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding ResetBossTimerHotkeyCommand}" Content="↺" ToolTip="{loc:Loc BossTimer_HotkeyResetTooltip}" Padding="8,4" FontSize="12" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Repress Behavior Row -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc BossTimer_RepressBehavior}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                <ComboBox Grid.Column="1" Width="160"
                                                          ItemsSource="{Binding AvailableRepressBehaviors}"
                                                          SelectedValuePath="Behavior"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValue="{Binding BossTimerRepressBehavior}"
                                                          Validation.ErrorTemplate="{x:Null}" />
                                            </Grid>

                                            <!-- Sound Confirmation Checkbox -->
                                            <CheckBox Content="{loc:Loc BossTimer_PlayHotkeySound}" IsChecked="{Binding BossTimerPlayHotkeySound}" Style="{StaticResource ModernCheckBoxStyle}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Right Column: Audio & Visuals -->
                                <StackPanel Grid.Column="2">
                                    <!-- Card 3: Audio & Repeat Alerts -->
                                    <Border Background="#141D2B" BorderBrush="#2A384C" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc BossTimer_CardAudio}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource AccentWaitingBrush}" Margin="0,0,0,10" />

                                            <!-- Warning Alert Row -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Content="{loc:Loc BossTimer_WarningAlert}" IsChecked="{Binding BossTimerEnableWarningAlert}" Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:Loc BossTimer_WarningSeconds}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,6,0" />
                                                    <TextBox Width="45" Text="{Binding BossTimerWarningSeconds, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" Margin="0,0,6,0" />
                                                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding TestBossWarningSoundCommand}" Content="{loc:Loc BossTimer_TestSound}" Padding="8,3" FontSize="10.5" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Spawn Alert Row -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Content="{loc:Loc BossTimer_SpawnAlert}" IsChecked="{Binding BossTimerEnableSpawnAlert}" Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ComboBox Width="135" ItemsSource="{Binding AvailableSoundPresets}" SelectedValuePath="Preset" DisplayMemberPath="DisplayName" SelectedValue="{Binding BossTimerSpawnSoundPreset}" Validation.ErrorTemplate="{x:Null}" Margin="0,0,6,0" />
                                                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding TestBossSpawnSoundCommand}" Content="{loc:Loc BossTimer_TestSound}" Padding="8,3" FontSize="10.5" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Volume Slider -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="130" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc BossTimer_Volume}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding BossTimerVolume}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Repeat Alerts Checkbox -->
                                            <CheckBox Content="{loc:Loc BossTimer_EnableRepeatAlert}"
                                                      IsChecked="{Binding BossTimerEnableRepeatAlert}"
                                                      Style="{StaticResource ModernCheckBoxStyle}"
                                                      Margin="0,0,0,6" />

                                            <!-- Repeat Alerts Count and Interval (indented) -->
                                            <Grid Margin="22,6,0,0" Visibility="{Binding BossTimerEnableRepeatAlert, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc BossTimer_RepeatSettings}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:Loc BossTimer_RepeatCount}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,4,0" />
                                                    <TextBox Width="42" Text="{Binding BossTimerRepeatCount, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="{loc:Loc BossTimer_RepeatInterval}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,4,0" />
                                                    <TextBox Width="42" Text="{Binding BossTimerRepeatInterval, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 4: Visuals & Color Palette -->
                                    <Border Background="#141D2B" BorderBrush="#2A384C" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc BossTimer_CardVisuals}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource AccentWaitingBrush}" Margin="0,0,0,10" />

                                            <CheckBox Content="{loc:Loc BossTimer_ShowToast}" IsChecked="{Binding BossTimerShowToast}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,8" />
                                            <CheckBox Content="{loc:Loc BossTimer_FlashCard}" IsChecked="{Binding BossTimerFlashCard}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />

                                            <!-- Auto-Hide Delay -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="70" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc BossTimer_AutoHide}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                <TextBox Grid.Column="1" Text="{Binding BossTimerAutoHideSeconds, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                                            </Grid>

                                            <!-- Visual Accent Color Picker & Hex Input -->
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc BossTimer_Color}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Command="{Binding PickBossColorCommand}" 
                                                            Style="{StaticResource ModernDarkButtonStyle}"
                                                            Padding="8,4" Margin="0,0,6,0" Cursor="Hand"
                                                            ToolTip="{loc:Loc BossTimer_ColorTooltip}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="16" Height="16" Background="{Binding BossTimerColorHex, FallbackValue='#EF4444', TargetNullValue='#EF4444'}" CornerRadius="3" BorderBrush="#334155" BorderThickness="1" Margin="0,0,6,0" />
                                                            <TextBlock Text="🎨 " FontSize="11" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding BossTimerColorHex}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBox Width="75" Text="{Binding BossTimerColorHex, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab: Kill Counter -->
                    <TabItem Header="{loc:Loc Settings_TabKillCounter}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="16,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Target & Session Counts -->
                                <StackPanel Grid.Column="0">
                                    <Border Background="#141D2B" BorderBrush="#2A384C" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc KillCounter_CardTarget}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource AccentWaitingBrush}" Margin="0,0,0,10" />

                                            <!-- Target Name Input -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="170" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc KillCounter_TargetName}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                <TextBox Grid.Column="1" Text="{Binding KillCounterBossName, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>

                                            <!-- Quick Presets -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc KillCounter_QuickPresets}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,8,0" />
                                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding SetKillCounterPresetCommand}" CommandParameter="Treant" Content="Treant" Padding="7,3" FontSize="10.5" Margin="0,0,4,4" />
                                                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding SetKillCounterPresetCommand}" CommandParameter="Hound" Content="Hound" Padding="7,3" FontSize="10.5" Margin="0,0,4,4" />
                                                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding SetKillCounterPresetCommand}" CommandParameter="Arachsiam" Content="Arachsiam" Padding="7,3" FontSize="10.5" Margin="0,0,4,4" />
                                                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding SetKillCounterPresetCommand}" CommandParameter="Silo" Content="Silo" Padding="7,3" FontSize="10.5" Margin="0,0,4,4" />
                                                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding SetKillCounterPresetCommand}" CommandParameter="Prime War" Content="Prime War" Padding="7,3" FontSize="10.5" Margin="0,0,4,4" />
                                                </WrapPanel>
                                            </Grid>

                                            <Rectangle Height="1" Fill="#1E293B" Margin="0,2,0,10" />

                                            <!-- Current Count with [-] and [+] Buttons -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc KillCounter_CurrentCount}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding DecrementKillCountCommand}" Content="-" Padding="10,3" FontSize="13" FontWeight="Bold" Margin="0,0,6,0" />
                                                    <TextBox Width="50" Text="{Binding KillCounterCurrentCount, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Margin="0,0,6,0" />
                                                    <Button Style="{StaticResource PrimaryAccentButtonStyle}" Command="{Binding IncrementKillCountCommand}" Content="+" Padding="10,3" FontSize="13" FontWeight="Bold" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Goal Checkbox & Number Input -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Content="{loc:Loc KillCounter_EnableGoal}" IsChecked="{Binding KillCounterEnableGoal}" Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding KillCounterEnableGoal, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{loc:Loc KillCounter_GoalCount}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,6,0" />
                                                    <TextBox Width="50" Text="{Binding KillCounterGoalCount, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Total All-Time Count Display -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc KillCounter_TotalAllTime}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                <TextBlock Grid.Column="1" Text="{Binding KillCounterTotalAllTimeCount}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentActiveBrush}" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Reset Session Button -->
                                            <Button Command="{Binding ResetKillCounterSessionCommand}"
                                                    Style="{StaticResource DangerDarkButtonStyle}"
                                                    Content="{loc:Loc KillCounter_ResetSession}"
                                                    Padding="10,5" FontSize="11" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Right Column: Activation, Hotkeys & Visuals -->
                                <StackPanel Grid.Column="2">
                                    <Border Background="#141D2B" BorderBrush="#2A384C" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc KillCounter_CardActivation}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource AccentWaitingBrush}" Margin="0,0,0,10" />

                                            <!-- Enable Checkbox -->
                                            <CheckBox Content="{loc:Loc KillCounter_Enable}" IsChecked="{Binding KillCounterEnabled}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />

                                            <!-- Increment Hotkey -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc KillCounter_IncrementHotkey}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <controls:HotkeyBox Width="120" Height="28" Hotkey="{Binding KillCounterIncrementHotkey, Mode=TwoWay}" PromptText="{loc:Loc BossTimer_HotkeyRecorderPrompt}" Margin="0,0,6,0" />
                                                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding ResetKillCounterIncrementHotkeyCommand}" Content="↺" ToolTip="{loc:Loc KillCounter_HotkeyResetTooltip}" Padding="8,4" FontSize="12" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Decrement Hotkey -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc KillCounter_DecrementHotkey}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <controls:HotkeyBox Width="120" Height="28" Hotkey="{Binding KillCounterDecrementHotkey, Mode=TwoWay}" PromptText="{loc:Loc BossTimer_HotkeyRecorderPrompt}" Margin="0,0,6,0" />
                                                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding ResetKillCounterDecrementHotkeyCommand}" Content="↺" ToolTip="{loc:Loc KillCounter_HotkeyResetTooltip}" Padding="8,4" FontSize="12" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Play Sound Confirmation -->
                                            <CheckBox Content="{loc:Loc KillCounter_PlaySound}" IsChecked="{Binding KillCounterPlaySound}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,8" />

                                            <!-- Auto-start Boss Timer -->
                                            <CheckBox Content="{loc:Loc KillCounter_AutoStartBossTimer}" IsChecked="{Binding KillCounterAutoStartBossTimer}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,8" />

                                            <!-- Flash on Goal Reached -->
                                            <CheckBox Content="{loc:Loc KillCounter_FlashOnGoalReached}" IsChecked="{Binding KillCounterFlashOnGoalReached}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,8" />

                                            <!-- Show in Mini-HUD -->
                                            <CheckBox Content="{loc:Loc KillCounter_ShowInMiniHud}" IsChecked="{Binding KillCounterShowInMiniHud}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />

                                            <!-- Accent Color Picker & Hex Input -->
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc KillCounter_Color}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Command="{Binding PickKillCounterColorCommand}" 
                                                            Style="{StaticResource ModernDarkButtonStyle}"
                                                            Padding="8,4" Margin="0,0,6,0" Cursor="Hand"
                                                            ToolTip="{loc:Loc KillCounter_ColorTooltip}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="16" Height="16" Background="{Binding KillCounterColorHex, FallbackValue='#EF4444', TargetNullValue='#EF4444'}" CornerRadius="3" BorderBrush="#334155" BorderThickness="1" Margin="0,0,6,0" />
                                                            <TextBlock Text="🎨 " FontSize="11" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding KillCounterColorHex}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBox Width="75" Text="{Binding KillCounterColorHex, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 3: Appearance -->
                    <TabItem Header="{loc:Loc Settings_TabAppearance}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Settings_Opacity}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="0.2" Maximum="1.0" Value="{Binding Opacity}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Settings_Scale}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="0.8" Maximum="1.6" Value="{Binding Scale}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Appearance Minimization & HUD Elements Toggles -->
                                <CheckBox Content="{loc:Loc Settings_CompactMode}" IsChecked="{Binding CompactMode}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="{loc:Loc Settings_ShowMiniControls}" IsChecked="{Binding ShowMiniControls}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="{loc:Loc Settings_ShowBorder}" IsChecked="{Binding ShowBorder}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="{loc:Loc Settings_ShowBackground}" IsChecked="{Binding ShowBackground}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="{loc:Loc Settings_ShowProgressRing}" IsChecked="{Binding ShowProgressRing}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="{loc:Loc Settings_ShowNextEventTime}" IsChecked="{Binding ShowNextEventTime}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="{loc:Loc Settings_AlwaysOnTop}" IsChecked="{Binding AlwaysOnTop}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="{loc:Loc Settings_LockPosition}" IsChecked="{Binding IsLocked}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="{loc:Loc Settings_ClickThrough}" IsChecked="{Binding IsClickThrough}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,12" />

                                <!-- Language Selection -->
                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Settings_Language}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding SupportedLanguages}"
                                              SelectedItem="{Binding SelectedLanguage}"
                                              DisplayMemberPath="NativeName"
                                              Background="#1E293B"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              Padding="4" />
                                </Grid>

                                <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding ResetPositionCommand}" Content="{loc:Loc Settings_ResetPosition}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 4: System -->
                    <TabItem Header="{loc:Loc Settings_TabSystem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <!-- Windows Autostart Card -->
                                <Border Background="#141D2B" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <CheckBox Content="{loc:Loc Settings_StartWithWindows}"
                                                  IsChecked="{Binding StartWithWindows}"
                                                  Style="{StaticResource ModernCheckBoxStyle}"
                                                  FontWeight="SemiBold"
                                                  FontSize="12.5"
                                                  Margin="0,0,0,6" />
                                        <TextBlock Text="{loc:Loc Settings_StartWithWindows_Desc}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"
                                                   Margin="24,0,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Auto-hide when game not in focus Card -->
                                <Border Background="#141D2B" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <CheckBox Content="{loc:Loc Settings_AutoHideGameFocus}"
                                                  IsChecked="{Binding AutoHideWhenGameOutOfFocus}"
                                                  Style="{StaticResource ModernCheckBoxStyle}"
                                                  FontWeight="SemiBold"
                                                  FontSize="12.5"
                                                  Margin="0,0,0,6" />
                                        <TextBlock Text="{loc:Loc Settings_AutoHideGameFocus_Desc}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"
                                                   Margin="24,0,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Settings Storage Location Card (Hybrid Portable / AppData) -->
                                <Border Background="#141D2B" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Settings_StorageMode}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding StorageModeDescription}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"
                                                   Margin="0,0,0,8"
                                                   TextWrapping="Wrap" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding SettingsFilePath, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     FontSize="10.5"
                                                     Foreground="{StaticResource TextSecondaryBrush}"
                                                     VerticalAlignment="Center"
                                                     ToolTip="{Binding SettingsFilePath}" />
                                            <Button Grid.Column="1"
                                                    Command="{Binding OpenSettingsFolderCommand}"
                                                    Style="{StaticResource ModernDarkButtonStyle}"
                                                    Content="{loc:Loc Settings_OpenFolder}"
                                                    Padding="10,4"
                                                    FontSize="10.5"
                                                    Margin="6,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 5: Hotkeys -->
                    <TabItem Header="{loc:Loc Settings_TabHotkeys}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <!-- Global Shortcut Hotkeys Card -->
                                <Border Background="#141D2B" BorderBrush="#2A384C" BorderThickness="1" CornerRadius="8" Padding="18,16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Settings_HotkeysCardTitle}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource AccentWaitingBrush}"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="{loc:Loc Settings_HotkeysHint}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,0,0,16" />

                                        <!-- Row 1: Toggle Overlay Visibility -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc Settings_HotkeyToggle}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{loc:Loc Settings_HotkeyToggleDesc}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:HotkeyBox Width="140" Height="28" Hotkey="{Binding ToggleVisibilityHotkey, Mode=TwoWay}" PromptText="{loc:Loc BossTimer_HotkeyRecorderPrompt}" Margin="0,0,6,0" />
                                                <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding ResetToggleVisibilityHotkeyCommand}" Content="↺" ToolTip="{loc:Loc Settings_HotkeyResetTooltip}" Padding="8,4" FontSize="12" />
                                            </StackPanel>
                                        </Grid>

                                        <Rectangle Height="1" Fill="#1E293B" Margin="0,0,0,14" />

                                        <!-- Row 2: Toggle Click-Through / Lock -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc Settings_HotkeyLock}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{loc:Loc Settings_HotkeyLockDesc}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:HotkeyBox Width="140" Height="28" Hotkey="{Binding ToggleClickThroughHotkey, Mode=TwoWay}" PromptText="{loc:Loc BossTimer_HotkeyRecorderPrompt}" Margin="0,0,6,0" />
                                                <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding ResetToggleClickThroughHotkeyCommand}" Content="↺" ToolTip="{loc:Loc Settings_HotkeyResetTooltip}" Padding="8,4" FontSize="12" />
                                            </StackPanel>
                                        </Grid>

                                        <Rectangle Height="1" Fill="#1E293B" Margin="0,0,0,14" />

                                        <!-- Row 3: Toggle Pause Alerts -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc Settings_HotkeyPauseAlerts}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{loc:Loc Settings_HotkeyPauseAlertsDesc}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:HotkeyBox Width="140" Height="28" Hotkey="{Binding TogglePauseAlertsHotkey, Mode=TwoWay}" PromptText="{loc:Loc BossTimer_HotkeyRecorderPrompt}" Margin="0,0,6,0" />
                                                <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding ResetTogglePauseAlertsHotkeyCommand}" Content="↺" ToolTip="{loc:Loc Settings_HotkeyResetTooltip}" Padding="8,4" FontSize="12" />
                                            </StackPanel>
                                        </Grid>

                                        <Rectangle Height="1" Fill="#1E293B" Margin="0,0,0,14" />

                                        <!-- Row 4: Dedicated Boss Respawn Timer -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc Settings_HotkeyBossTimer}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{loc:Loc Settings_HotkeyBossTimerDesc}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:HotkeyBox Width="140" Height="28" Hotkey="{Binding BossTimerHotkey, Mode=TwoWay}" PromptText="{loc:Loc BossTimer_HotkeyRecorderPrompt}" Margin="0,0,6,0" />
                                                <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding ResetBossTimerHotkeyCommand}" Content="↺" ToolTip="{loc:Loc BossTimer_HotkeyResetTooltip}" Padding="8,4" FontSize="12" />
                                            </StackPanel>
                                        </Grid>

                                        <Rectangle Height="1" Fill="#1E293B" Margin="0,0,0,14" />

                                        <!-- Row 5: Kill Counter Increment (+1) -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc Settings_HotkeyKillIncrement}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{loc:Loc Settings_HotkeyKillIncrementDesc}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:HotkeyBox Width="140" Height="28" Hotkey="{Binding KillCounterIncrementHotkey, Mode=TwoWay}" PromptText="{loc:Loc BossTimer_HotkeyRecorderPrompt}" Margin="0,0,6,0" />
                                                <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding ResetKillCounterIncrementHotkeyCommand}" Content="↺" ToolTip="{loc:Loc KillCounter_HotkeyResetTooltip}" Padding="8,4" FontSize="12" />
                                            </StackPanel>
                                        </Grid>

                                        <Rectangle Height="1" Fill="#1E293B" Margin="0,0,0,14" />

                                        <!-- Row 6: Kill Counter Decrement / Undo (-1) -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc Settings_HotkeyKillDecrement}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{loc:Loc Settings_HotkeyKillDecrementDesc}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:HotkeyBox Width="140" Height="28" Hotkey="{Binding KillCounterDecrementHotkey, Mode=TwoWay}" PromptText="{loc:Loc BossTimer_HotkeyRecorderPrompt}" Margin="0,0,6,0" />
                                                <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding ResetKillCounterDecrementHotkeyCommand}" Content="↺" ToolTip="{loc:Loc KillCounter_HotkeyResetTooltip}" Padding="8,4" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 6: About -->
                    <TabItem Header="{loc:Loc Settings_TabAbout}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <TextBlock Text="{loc:Loc App_Title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentWaitingBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding AppVersionText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10" />
                                <TextBlock Text="{loc:Loc About_Desc}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,12" />

                                <!-- Clickable Author & Repository Link -->
                                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,14">
                                    <Run Text="Created by " Foreground="{StaticResource TextMutedBrush}" />
                                    <Hyperlink NavigateUri="https://github.com/vtstv" RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="Murr" Foreground="{StaticResource AccentWaitingBrush}" FontWeight="SemiBold" TextDecorations="Underline" />
                                    </Hyperlink>
                                    <Run Text=" (" Foreground="{StaticResource TextMutedBrush}" />
                                    <Hyperlink NavigateUri="https://github.com/vtstv/OHTimer" RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="https://github.com/vtstv/OHTimer" Foreground="{StaticResource AccentWaitingBrush}" TextDecorations="Underline" />
                                    </Hyperlink>
                                    <Run Text=") for the Once Human community." Foreground="{StaticResource TextMutedBrush}" />
                                </TextBlock>

                                <Button Style="{StaticResource ModernDarkButtonStyle}"
                                        Click="OpenGitHub_Click"
                                        Content="{loc:Loc About_GitHub}"
                                        HorizontalAlignment="Left"
                                        Padding="14,6"
                                        Margin="0,0,0,16" />

                                <!-- Interactive Quick Start Guide / Tutorial -->
                                <Border Background="#141D2B" BorderBrush="#2A384C" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc Settings_TutorialTitle}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentWaitingBrush}" Margin="0,0,0,2" />
                                            <TextBlock Text="{loc:Loc Settings_TutorialDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource PrimaryAccentButtonStyle}"
                                                Command="{Binding RestartOnboardingCommand}"
                                                Content="{loc:Loc Settings_LaunchTutorial}"
                                                Padding="14,6"
                                                FontSize="11"
                                                VerticalAlignment="Center"
                                                Margin="12,0,0,0" />
                                    </Grid>
                                </Border>

                                <!-- Software Updates Section -->
                                <Border Background="#161B26" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Update_SectionTitle}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                            <Button Style="{StaticResource ModernDarkButtonStyle}"
                                                    Command="{Binding CheckForUpdatesCommand}"
                                                    Content="{loc:Loc Update_CheckButton}"
                                                    Padding="12,6"
                                                    Margin="0,0,12,0" />

                                            <TextBlock Text="{Binding UpdateStatusMessage}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="450" />
                                        </StackPanel>

                                        <!-- Update Available & Changelog Panel -->
                                        <Border Margin="0,8,0,0"
                                                Background="#1E2430"
                                                BorderBrush="{StaticResource AccentWaitingBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="12"
                                                Visibility="{Binding ShowUpdateAvailablePanel, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc Update_ReleaseNotes}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="{StaticResource AccentWaitingBrush}"
                                                           Margin="0,0,0,6" />

                                                <Border MaxHeight="140"
                                                        Background="#0B0F17"
                                                        BorderBrush="{StaticResource BorderDarkBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8"
                                                        Margin="0,0,0,10">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <TextBlock Text="{Binding ReleaseNotes}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="11"
                                                                   FontFamily="Consolas, monospace"
                                                                   TextWrapping="Wrap" />
                                                    </ScrollViewer>
                                                </Border>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource PrimaryAccentButtonStyle}"
                                                            Command="{Binding ApplyUpdateCommand}"
                                                            Content="{loc:Loc Update_DownloadAndApply}"
                                                            Padding="14,6"
                                                            Margin="0,0,12,0" />

                                                    <ProgressBar Width="180" Height="8"
                                                                 Minimum="0" Maximum="100"
                                                                 Value="{Binding UpdateDownloadProgress}"
                                                                 Foreground="{StaticResource AccentWaitingBrush}"
                                                                 Background="#0B0F17"
                                                                 BorderBrush="{StaticResource BorderDarkBrush}"
                                                                 Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Bottom Action Bar -->
            <Grid Grid.Row="2" Margin="16,10,16,14">
                <TextBlock Text="{loc:Loc Settings_SavedSuccess}"
                           Foreground="#22C55E"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Visibility="{Binding ShowSavedNotification, Converter={StaticResource BoolToVis}}" />

                <Button Style="{StaticResource PrimaryAccentButtonStyle}"
                        Command="{Binding SaveCommand}"
                        Content="{loc:Loc Settings_Save}"
                        HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Border>
</Window>
