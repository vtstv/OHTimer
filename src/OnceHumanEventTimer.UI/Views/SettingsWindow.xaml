<Window x:Class="OnceHumanEventTimer.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:OnceHumanEventTimer.UI.Localization"
        xmlns:vm="clr-namespace:OnceHumanEventTimer.UI.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        mc:Ignorable="d"
        Title="{loc:Loc Settings_Title}"
        Width="780" Height="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="{loc:Loc Settings_Title}"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="{StaticResource AccentWaitingBrush}"
                   Margin="0,0,0,14" />

        <!-- Tab Content -->
        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource BorderDarkBrush}">
            <!-- Tab 1: Events & Presets (Universal Multi-Wheel Engine) -->
            <TabItem Header="{loc:Loc Settings_TabEvents}">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Event Presets List & Controls -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0"
                                 ItemsSource="{Binding Events}"
                                 SelectedItem="{Binding SelectedEvent}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  Style="{StaticResource ModernCheckBoxStyle}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"
                                                  ToolTip="{loc:Loc Settings_EventEnabled}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{Binding ColorHex}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="195" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="210" Margin="13,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Command="{Binding AddEventCommand}"
                                    Style="{StaticResource ModernDarkButtonStyle}"
                                    Content="{loc:Loc Settings_AddEvent}"
                                    Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                            <Button Command="{Binding DeleteEventCommand}"
                                    Style="{StaticResource DangerDarkButtonStyle}"
                                    Content="{loc:Loc Settings_DeleteEvent}"
                                    Padding="8,4" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <!-- Right: Selected Event Details & Game Sync -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6,0,6,0">
                            <!-- Active Status / Action -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedEventName}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentWaitingBrush}" />
                                    <TextBlock Text="Configure timing rules and drift offset."
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Command="{Binding SetActiveEventCommand}"
                                        Style="{StaticResource PrimaryAccentButtonStyle}"
                                        Content="Set as Active"
                                        Padding="10,4"
                                        FontSize="11"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <Rectangle Height="1" Fill="{StaticResource BorderDarkBrush}" Margin="0,0,0,8" />

                            <!-- Enable in Multi-Timer HUD -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Settings_EventEnabled}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding SelectedEventIsEnabled, Mode=TwoWay}" Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Event Configuration Fields -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Settings_EventName}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                <TextBox Grid.Column="1" Text="{Binding SelectedEventName, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Settings_CycleMinutes}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                <TextBox Grid.Column="1" Text="{Binding SelectedEventCycleMinutes, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Settings_StartMinute}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                <TextBox Grid.Column="1" Text="{Binding SelectedEventStartMinute, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Settings_DurationMinutes}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                <TextBox Grid.Column="1" Text="{Binding SelectedEventDurationMinutes, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Settings_TimeOffset}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                <TextBox Grid.Column="1" Text="{Binding SelectedEventTimeOffsetSeconds, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Settings_EventColor}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                <TextBox Grid.Column="1" Text="{Binding SelectedEventColorHex, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                            </Grid>

                            <!-- Game Synchronization Card -->
                            <Border Background="#141D2B"
                                    BorderBrush="{StaticResource AccentWaitingBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,2,0,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Settings_SyncToGame}"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="{StaticResource AccentWaitingBrush}" />

                                    <TextBlock Text="Calibrate PC clock to Once Human server drift instantly:"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,2,0,6" />

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Settings_GameRemaining}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="11" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding GameRemainingInput, UpdateSourceTrigger=PropertyChanged}"
                                                 HorizontalContentAlignment="Center"
                                                 Margin="0,0,6,0" />
                                        <Button Grid.Column="2"
                                                Command="{Binding SyncToGameCommand}"
                                                Style="{StaticResource PrimaryAccentButtonStyle}"
                                                Content="{loc:Loc Settings_SyncButton}"
                                                Padding="10,3"
                                                FontSize="11" />
                                    </Grid>

                                    <!-- Quick Nudge Buttons -->
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Nudge: " Foreground="{StaticResource TextMutedBrush}" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,3,0" />
                                        <Button Content="-5s" Command="{Binding NudgeOffsetCommand}" CommandParameter="-5" Style="{StaticResource ModernDarkButtonStyle}" Padding="5,1" FontSize="9.5" Margin="0,0,2,0" />
                                        <Button Content="-1s" Command="{Binding NudgeOffsetCommand}" CommandParameter="-1" Style="{StaticResource ModernDarkButtonStyle}" Padding="5,1" FontSize="9.5" Margin="0,0,2,0" />
                                        <Button Content="+1s" Command="{Binding NudgeOffsetCommand}" CommandParameter="1" Style="{StaticResource ModernDarkButtonStyle}" Padding="5,1" FontSize="9.5" Margin="0,0,2,0" />
                                        <Button Content="+5s" Command="{Binding NudgeOffsetCommand}" CommandParameter="5" Style="{StaticResource ModernDarkButtonStyle}" Padding="5,1" FontSize="9.5" Margin="0,0,2,0" />
                                        <Button Content="0s" Command="{Binding NudgeOffsetCommand}" CommandParameter="0" Style="{StaticResource ModernDarkButtonStyle}" Padding="5,1" FontSize="9.5" />
                                    </StackPanel>

                                    <!-- Feedback notification -->
                                    <TextBlock Text="{Binding SyncFeedbackMessage}"
                                               Foreground="#22C55E"
                                               FontWeight="SemiBold"
                                               FontSize="10.5"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding ShowSyncFeedback, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Tab 2: Alerts & Audio -->
            <TabItem Header="{loc:Loc Settings_TabNotifications}">
                <StackPanel Margin="16">
                    <CheckBox Content="{loc:Loc Settings_PlaySound}" IsChecked="{Binding PlayAlertSound}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                    <CheckBox Content="{loc:Loc Settings_PlayOnStart}" IsChecked="{Binding PlayOnEventStart}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                    <CheckBox Content="{loc:Loc Settings_ShowToast}" IsChecked="{Binding ShowToastAlert}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Settings_Volume}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Volume}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Settings_AlertBeforeStart}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding AlertMinutesBefore, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Settings_AlertBeforeEnd}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding AlertMinutesBeforeEnd, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                    </Grid>

                    <!-- Custom Audio -->
                    <TextBlock Text="{loc:Loc Settings_CustomSound}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding CustomSoundPath}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding BrowseSoundCommand}" Content="{loc:Loc Settings_Browse}" Margin="8,0,0,0" />
                    </Grid>

                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding TestAudioCommand}" Content="{loc:Loc Settings_TestAudio}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                </StackPanel>
            </TabItem>

            <!-- Tab 3: Appearance -->
            <TabItem Header="{loc:Loc Settings_TabAppearance}">
                <StackPanel Margin="16">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Settings_Opacity}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Slider Grid.Column="1" Minimum="0.2" Maximum="1.0" Value="{Binding Opacity}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Settings_Scale}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Slider Grid.Column="1" Minimum="0.8" Maximum="1.6" Value="{Binding Scale}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" />
                    </Grid>

                    <CheckBox Content="{loc:Loc Settings_CompactMode}" IsChecked="{Binding CompactMode}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                    <CheckBox Content="{loc:Loc Settings_AlwaysOnTop}" IsChecked="{Binding AlwaysOnTop}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                    <CheckBox Content="{loc:Loc Settings_LockPosition}" IsChecked="{Binding IsLocked}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                    <CheckBox Content="{loc:Loc Settings_ClickThrough}" IsChecked="{Binding IsClickThrough}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,12" />

                    <!-- Language Selection -->
                    <Grid Margin="0,8,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Settings_Language}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SupportedLanguages}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  DisplayMemberPath="NativeName"
                                  Background="#1E293B"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Padding="4" />
                    </Grid>

                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding ResetPositionCommand}" Content="{loc:Loc Settings_ResetPosition}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                </StackPanel>
            </TabItem>

            <!-- Tab 4: Hotkeys -->
            <TabItem Header="{loc:Loc Settings_TabHotkeys}">
                <StackPanel Margin="16">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Settings_HotkeyToggle}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding ToggleVisibilityHotkey, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Settings_HotkeyLock}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding ToggleClickThroughHotkey, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- Tab 5: About & Updates -->
            <TabItem Header="{loc:Loc Settings_TabAbout}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="{loc:Loc App_Title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentWaitingBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="Version 1.2.0" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10" />
                        <TextBlock Text="{loc:Loc About_Desc}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,12" />
                        <TextBlock Text="{loc:Loc About_Author}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,16" />

                        <!-- Software Updates Section -->
                        <Border Background="#161B26" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Update_SectionTitle}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <Button Style="{StaticResource ModernDarkButtonStyle}"
                                            Command="{Binding CheckForUpdatesCommand}"
                                            Content="{loc:Loc Update_CheckButton}"
                                            Padding="12,6"
                                            Margin="0,0,12,0" />

                                    <TextBlock Text="{Binding UpdateStatusMessage}"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="420" />
                                </StackPanel>

                                <!-- Update Available & Changelog Panel -->
                                <Border Margin="0,8,0,0"
                                        Background="#1E2430"
                                        BorderBrush="{StaticResource AccentWaitingBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="12"
                                        Visibility="{Binding ShowUpdateAvailablePanel, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Update_ReleaseNotes}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="{StaticResource AccentWaitingBrush}"
                                                   Margin="0,0,0,6" />

                                        <Border MaxHeight="140"
                                                Background="#0B0F17"
                                                BorderBrush="{StaticResource BorderDarkBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8"
                                                Margin="0,0,0,10">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding ReleaseNotes}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11"
                                                           FontFamily="Consolas, monospace"
                                                           TextWrapping="Wrap" />
                                            </ScrollViewer>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource PrimaryAccentButtonStyle}"
                                                    Command="{Binding ApplyUpdateCommand}"
                                                    Content="{loc:Loc Update_DownloadAndApply}"
                                                    Padding="14,6"
                                                    Margin="0,0,12,0" />

                                            <ProgressBar Width="180" Height="8"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding UpdateDownloadProgress}"
                                                         Foreground="{StaticResource AccentWaitingBrush}"
                                                         Background="#0B0F17"
                                                         BorderBrush="{StaticResource BorderDarkBrush}"
                                                         Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{loc:Loc Settings_SavedSuccess}"
                       Foreground="#22C55E"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Visibility="{Binding ShowSavedNotification, Converter={StaticResource BoolToVis}}" />

            <Button Style="{StaticResource PrimaryAccentButtonStyle}"
                    Command="{Binding SaveCommand}"
                    Content="{loc:Loc Settings_Save}"
                    HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
