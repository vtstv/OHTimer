<Window x:Class="OnceHumanEventTimer.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:OnceHumanEventTimer.UI.Localization"
        xmlns:vm="clr-namespace:OnceHumanEventTimer.UI.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        mc:Ignorable="d"
        Title="{loc:Loc Settings_Title}"
        Width="820" Height="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/ScrollBars.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#1E293B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom Dark Titlebar -->
            <Grid Grid.Row="0" Background="#0E121A">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Title & Icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="pack://application:,,,/Assets/app.ico" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Once Human: Event Timer — Settings"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right Window Control Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimize">
                        <TextBlock Text="—" FontSize="11" Foreground="#94A3B8" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click" ToolTip="Maximize">
                        <TextBlock Text="▢" FontSize="12" Foreground="#94A3B8" />
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}" Click="CloseButton_Click" ToolTip="Close">
                        <TextBlock Text="✕" FontSize="11" Foreground="#94A3B8" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Tab Content -->
            <Grid Grid.Row="1" Margin="14,10,14,0">
                <TabControl Background="Transparent" BorderBrush="{StaticResource BorderDarkBrush}">
                    <!-- Tab 1: Events & Presets (Universal Multi-Wheel Engine) -->
                    <TabItem Header="{loc:Loc Settings_TabEvents}">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Event Presets List & Controls -->
                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ListBox Grid.Row="0"
                                         ItemsSource="{Binding Events}"
                                         SelectedItem="{Binding SelectedEvent}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          Style="{StaticResource ModernCheckBoxStyle}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0"
                                                          ToolTip="{loc:Loc Settings_EventEnabled}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding ColorHex}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="200" Margin="13,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Reordering controls -->
                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Command="{Binding MoveEventToTopCommand}"
                                            IsEnabled="{Binding CanMoveSelectedEventUp}"
                                            Style="{StaticResource ModernDarkButtonStyle}"
                                            Content="{loc:Loc Settings_MoveTop}"
                                            Padding="2,4" FontSize="10" Margin="0,0,2,0"
                                            ToolTip="{loc:Loc Settings_MoveTop}" />
                                    <Button Grid.Column="1"
                                            Command="{Binding MoveEventUpCommand}"
                                            IsEnabled="{Binding CanMoveSelectedEventUp}"
                                            Style="{StaticResource ModernDarkButtonStyle}"
                                            Content="▲"
                                            Padding="2,4" FontSize="10" Margin="2,0,2,0"
                                            ToolTip="{loc:Loc Settings_MoveUp}" />
                                    <Button Grid.Column="2"
                                            Command="{Binding MoveEventDownCommand}"
                                            IsEnabled="{Binding CanMoveSelectedEventDown}"
                                            Style="{StaticResource ModernDarkButtonStyle}"
                                            Content="▼"
                                            Padding="2,4" FontSize="10" Margin="2,0,0,0"
                                            ToolTip="{loc:Loc Settings_MoveDown}" />
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Top row: Add and Delete side-by-side -->
                                    <Button Grid.Row="0" Grid.Column="0"
                                            Command="{Binding AddEventCommand}"
                                            Style="{StaticResource ModernDarkButtonStyle}"
                                            Content="{loc:Loc Settings_AddEvent}"
                                            Padding="4,6" FontSize="11" Margin="0,0,3,4"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Row="0" Grid.Column="1"
                                            Command="{Binding DeleteEventCommand}"
                                            Style="{StaticResource DangerDarkButtonStyle}"
                                            Content="{loc:Loc Settings_DeleteEvent}"
                                            Padding="4,6" FontSize="11" Margin="3,0,0,4"
                                            HorizontalAlignment="Stretch" />

                                    <!-- Bottom row: Full-width Restore Presets button -->
                                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                            Command="{Binding RestoreDefaultPresetsCommand}"
                                            Style="{StaticResource ModernDarkButtonStyle}"
                                            Content="{loc:Loc Settings_RestorePresets}"
                                            Padding="4,6" FontSize="11" Margin="0,2,0,0"
                                            HorizontalAlignment="Stretch" />
                                </Grid>
                            </Grid>

                            <!-- Right: Selected Event Details & Game Sync -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="6,0,6,0">
                                    <!-- Active Status / Action -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedEventName}"
                                                       FontSize="13.5"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentWaitingBrush}" />
                                            <TextBlock Text="Configure timing rules, colors, audio, and drift offset."
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Command="{Binding SetActiveEventCommand}"
                                                Style="{StaticResource PrimaryAccentButtonStyle}"
                                                Content="Set as Active"
                                                Padding="10,4"
                                                FontSize="11"
                                                VerticalAlignment="Center" />
                                    </Grid>

                                    <Rectangle Height="1" Fill="{StaticResource BorderDarkBrush}" Margin="0,0,0,8" />

                                    <!-- Enable in Multi-Timer HUD -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Settings_EventEnabled}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding SelectedEventIsEnabled, Mode=TwoWay}" Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Event Configuration Fields -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Settings_EventName}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedEventName, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Settings_CycleMinutes}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedEventCycleMinutes, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Settings_StartTime}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox Width="36" Text="{Binding SelectedEventStartHour, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" ToolTip="Hour (0-23)" />
                                            <TextBlock Text=":" VerticalAlignment="Center" Margin="3,0" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" />
                                            <TextBox Width="36" Text="{Binding SelectedEventStartMinute, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" ToolTip="Minute (0-59)" />
                                            <TextBlock Text=":" VerticalAlignment="Center" Margin="3,0" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" />
                                            <TextBox Width="36" Text="{Binding SelectedEventStartSecond, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" ToolTip="Second (0-59)" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Calibrate Event Start from In-Game Countdown -->
                                    <Border Background="#141D2B"
                                            BorderBrush="#2A384C"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,6"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Settings_CalibrateStart_Title}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       Foreground="{StaticResource AccentWaitingBrush}"
                                                       Margin="0,0,0,2" />
                                            <TextBlock Text="{loc:Loc Settings_CalibrateStart_Desc}"
                                                       FontSize="9.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding EventRemainingInput, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,6,0"
                                                         VerticalContentAlignment="Center"
                                                         ToolTip="e.g. 1h 3m 29s, 3h 55m, 2 h 29 m 4 s, 01:03:29" />
                                                <Button Grid.Column="1"
                                                        Command="{Binding CalibrateEventStartCommand}"
                                                        Style="{StaticResource PrimaryAccentButtonStyle}"
                                                        Content="{loc:Loc Settings_CalibrateStart_Button}"
                                                        Padding="10,3"
                                                        FontSize="11" />
                                            </Grid>
                                            <TextBlock Text="{Binding CalibrateFeedbackMessage}"
                                                       Foreground="#22C55E"
                                                       FontWeight="SemiBold"
                                                       FontSize="10"
                                                       Margin="0,4,0,0"
                                                       Visibility="{Binding ShowCalibrateFeedback, Converter={StaticResource BoolToVis}}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Settings_DurationMinutes}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedEventDurationMinutes, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Settings_TimeOffset}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedEventTimeOffsetSeconds, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                                    </Grid>

                                    <!-- Visual Accent Color Picker & Hex Input -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Settings_EventColor}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding PickEventColorCommand}" 
                                                    Style="{StaticResource ModernDarkButtonStyle}"
                                                    Padding="8,4" Margin="0,0,6,0" Cursor="Hand"
                                                    ToolTip="Choose custom color from palette">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="16" Height="16" Background="{Binding SelectedEventColorHex, FallbackValue='#00F0FF', TargetNullValue='#00F0FF'}" CornerRadius="3" BorderBrush="#334155" BorderThickness="1" Margin="0,0,6,0" />
                                                    <TextBlock Text="🎨 " FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SelectedEventColorHex}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <TextBox Width="75" Text="{Binding SelectedEventColorHex, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Per-Event Audio Preset & Custom File -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Settings_EventSound}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox Width="145"
                                                      ItemsSource="{Binding AvailableSoundPresets}"
                                                      SelectedValuePath="Preset"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValue="{Binding SelectedEventSoundPreset}"
                                                      Validation.ErrorTemplate="{x:Null}"
                                                      Margin="0,0,4,0" />
                                            <Button Command="{Binding PreviewEventSoundCommand}" Style="{StaticResource ModernDarkButtonStyle}" Content="{loc:Loc Settings_PreviewSound}" Padding="6,2" FontSize="10" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Event Custom Sound File (when Custom preset is selected) -->
                                    <Grid Margin="0,0,0,8" Visibility="{Binding IsSelectedEventCustomSound, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Settings_CustomSound}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox Width="140" Text="{Binding SelectedEventCustomSoundPath}" IsReadOnly="True" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="{Binding SelectedEventCustomSoundPath}" />
                                            <Button Command="{Binding BrowseEventSoundCommand}" Style="{StaticResource ModernDarkButtonStyle}" Content="{loc:Loc Settings_Browse}" Padding="6,2" FontSize="10" Margin="0,0,3,0" />
                                            <Button Command="{Binding ClearEventSoundCommand}" Style="{StaticResource DangerDarkButtonStyle}" Content="{loc:Loc Settings_Clear}" Padding="6,2" FontSize="10" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Upcoming Visibility Filter Card -->
                                    <Border Background="#141D2B"
                                            BorderBrush="#2A384C"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,6"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding SelectedEventShowOnlyWhenUpcoming, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="{loc:Loc Settings_ShowOnlyWhenUpcoming}"
                                                      FontSize="11"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      Cursor="Hand" />
                                            <Grid Margin="22,6,0,0" Visibility="{Binding SelectedEventShowOnlyWhenUpcoming, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="65" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc Settings_UpcomingThreshold}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="10" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding SelectedEventUpcomingThresholdMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                         HorizontalContentAlignment="Center"
                                                         FontSize="11" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Game Server Skew Calibration Card -->
                                    <Border Background="#141D2B"
                                            BorderBrush="#2A384C"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10"
                                            Margin="0,2,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Settings_SyncToGame}"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       Foreground="{StaticResource AccentWaitingBrush}" />

                                            <TextBlock Text="{loc:Loc Settings_SyncDesc}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,6" />

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc Settings_GameRemaining}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="11" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding GameRemainingInput, UpdateSourceTrigger=PropertyChanged}"
                                                         HorizontalContentAlignment="Center"
                                                         Margin="0,0,6,0" />
                                                <Button Grid.Column="2"
                                                        Command="{Binding SyncToGameCommand}"
                                                        Style="{StaticResource PrimaryAccentButtonStyle}"
                                                        Content="{loc:Loc Settings_SyncButton}"
                                                        Padding="10,3"
                                                        FontSize="11" />
                                            </Grid>

                                            <!-- Quick Nudge Buttons -->
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="Nudge: " Foreground="{StaticResource TextMutedBrush}" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                <Button Content="-5s" Command="{Binding NudgeOffsetCommand}" CommandParameter="-5" Style="{StaticResource ModernDarkButtonStyle}" Padding="5,1" FontSize="9.5" Margin="0,0,2,0" />
                                                <Button Content="-1s" Command="{Binding NudgeOffsetCommand}" CommandParameter="-1" Style="{StaticResource ModernDarkButtonStyle}" Padding="5,1" FontSize="9.5" Margin="0,0,2,0" />
                                                <Button Content="+1s" Command="{Binding NudgeOffsetCommand}" CommandParameter="1" Style="{StaticResource ModernDarkButtonStyle}" Padding="5,1" FontSize="9.5" Margin="0,0,2,0" />
                                                <Button Content="+5s" Command="{Binding NudgeOffsetCommand}" CommandParameter="5" Style="{StaticResource ModernDarkButtonStyle}" Padding="5,1" FontSize="9.5" Margin="0,0,2,0" />
                                                <Button Content="0s" Command="{Binding NudgeOffsetCommand}" CommandParameter="0" Style="{StaticResource ModernDarkButtonStyle}" Padding="5,1" FontSize="9.5" />
                                            </StackPanel>

                                            <!-- Feedback notification -->
                                            <TextBlock Text="{Binding SyncFeedbackMessage}"
                                                       Foreground="#22C55E"
                                                       FontWeight="SemiBold"
                                                       FontSize="10.5"
                                                       Margin="0,6,0,0"
                                                       Visibility="{Binding ShowSyncFeedback, Converter={StaticResource BoolToVis}}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- Tab 2: Alerts & Audio -->
                    <TabItem Header="{loc:Loc Settings_TabNotifications}">
                        <StackPanel Margin="16">
                            <CheckBox Content="{loc:Loc Settings_PlaySound}" IsChecked="{Binding PlayAlertSound}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                            <CheckBox Content="{loc:Loc Settings_PauseAlerts}" IsChecked="{Binding AreAlertsPaused}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                            <CheckBox Content="{loc:Loc Settings_PlayOnStart}" IsChecked="{Binding PlayOnEventStart}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                            <CheckBox Content="{loc:Loc Settings_ShowToast}" IsChecked="{Binding ShowToastAlert}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Settings_Volume}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Volume}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Settings_AlertBeforeStart}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding AlertMinutesBefore, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Settings_AlertBeforeEnd}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding AlertMinutesBeforeEnd, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                            </Grid>

                            <!-- Default Alert Sound Preset -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Settings_DefaultSound}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox Width="160"
                                              ItemsSource="{Binding AvailableSoundPresets}"
                                              SelectedValuePath="Preset"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValue="{Binding AlertSoundPreset}"
                                              Validation.ErrorTemplate="{x:Null}"
                                              Margin="0,0,6,0" />
                                    <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding PreviewAlertSoundCommand}" Content="{loc:Loc Settings_PreviewSound}" Padding="8,4" FontSize="11" />
                                </StackPanel>
                            </Grid>

                            <!-- Global Custom Audio (when Custom preset is selected) -->
                            <StackPanel Margin="0,0,0,12" Visibility="{Binding IsCustomAlertSound, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Loc Settings_CustomSound}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding CustomSoundPath}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding BrowseSoundCommand}" Content="{loc:Loc Settings_Browse}" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <!-- Tab 3: Appearance -->
                    <TabItem Header="{loc:Loc Settings_TabAppearance}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Settings_Opacity}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="0.2" Maximum="1.0" Value="{Binding Opacity}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Settings_Scale}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="0.8" Maximum="1.6" Value="{Binding Scale}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Appearance Minimization & HUD Elements Toggles -->
                                <CheckBox Content="{loc:Loc Settings_CompactMode}" IsChecked="{Binding CompactMode}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="{loc:Loc Settings_ShowMiniControls}" IsChecked="{Binding ShowMiniControls}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="{loc:Loc Settings_ShowBorder}" IsChecked="{Binding ShowBorder}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="{loc:Loc Settings_ShowBackground}" IsChecked="{Binding ShowBackground}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="{loc:Loc Settings_ShowProgressRing}" IsChecked="{Binding ShowProgressRing}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="{loc:Loc Settings_ShowNextEventTime}" IsChecked="{Binding ShowNextEventTime}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="{loc:Loc Settings_AlwaysOnTop}" IsChecked="{Binding AlwaysOnTop}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="{loc:Loc Settings_LockPosition}" IsChecked="{Binding IsLocked}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,10" />
                                <CheckBox Content="{loc:Loc Settings_ClickThrough}" IsChecked="{Binding IsClickThrough}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,12" />

                                <!-- Language Selection -->
                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Settings_Language}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding SupportedLanguages}"
                                              SelectedItem="{Binding SelectedLanguage}"
                                              DisplayMemberPath="NativeName"
                                              Background="#1E293B"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              Padding="4" />
                                </Grid>

                                <Button Style="{StaticResource ModernDarkButtonStyle}" Command="{Binding ResetPositionCommand}" Content="{loc:Loc Settings_ResetPosition}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 4: System -->
                    <TabItem Header="{loc:Loc Settings_TabSystem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <!-- Windows Autostart Card -->
                                <Border Background="#141D2B" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <CheckBox Content="{loc:Loc Settings_StartWithWindows}"
                                                  IsChecked="{Binding StartWithWindows}"
                                                  Style="{StaticResource ModernCheckBoxStyle}"
                                                  FontWeight="SemiBold"
                                                  FontSize="12.5"
                                                  Margin="0,0,0,6" />
                                        <TextBlock Text="{loc:Loc Settings_StartWithWindows_Desc}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"
                                                   Margin="24,0,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Auto-hide when game not in focus Card -->
                                <Border Background="#141D2B" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <CheckBox Content="{loc:Loc Settings_AutoHideGameFocus}"
                                                  IsChecked="{Binding AutoHideWhenGameOutOfFocus}"
                                                  Style="{StaticResource ModernCheckBoxStyle}"
                                                  FontWeight="SemiBold"
                                                  FontSize="12.5"
                                                  Margin="0,0,0,6" />
                                        <TextBlock Text="{loc:Loc Settings_AutoHideGameFocus_Desc}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"
                                                   Margin="24,0,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Settings Storage Location Card (Hybrid Portable / AppData) -->
                                <Border Background="#141D2B" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Settings_StorageMode}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding StorageModeDescription}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"
                                                   Margin="0,0,0,8"
                                                   TextWrapping="Wrap" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding SettingsFilePath, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     FontSize="10.5"
                                                     Foreground="{StaticResource TextSecondaryBrush}"
                                                     VerticalAlignment="Center"
                                                     ToolTip="{Binding SettingsFilePath}" />
                                            <Button Grid.Column="1"
                                                    Command="{Binding OpenSettingsFolderCommand}"
                                                    Style="{StaticResource ModernDarkButtonStyle}"
                                                    Content="{loc:Loc Settings_OpenFolder}"
                                                    Padding="10,4"
                                                    FontSize="10.5"
                                                    Margin="6,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 5: Hotkeys -->
                    <TabItem Header="{loc:Loc Settings_TabHotkeys}">
                        <StackPanel Margin="16">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Settings_HotkeyToggle}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding ToggleVisibilityHotkey, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Settings_HotkeyLock}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding ToggleClickThroughHotkey, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Settings_HotkeyPauseAlerts}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding TogglePauseAlertsHotkey, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </TabItem>

                    <!-- Tab 6: About & Updates -->
                    <TabItem Header="{loc:Loc Settings_TabAbout}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <TextBlock Text="{loc:Loc App_Title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentWaitingBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Version 1.5.4" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10" />
                                <TextBlock Text="{loc:Loc About_Desc}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,12" />

                                <!-- Clickable Author & Repository Link -->
                                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,14">
                                    <Run Text="Created by " Foreground="{StaticResource TextMutedBrush}" />
                                    <Hyperlink NavigateUri="https://github.com/vtstv" RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="Murr" Foreground="{StaticResource AccentWaitingBrush}" FontWeight="SemiBold" TextDecorations="Underline" />
                                    </Hyperlink>
                                    <Run Text=" (" Foreground="{StaticResource TextMutedBrush}" />
                                    <Hyperlink NavigateUri="https://github.com/vtstv/OHTimer" RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="https://github.com/vtstv/OHTimer" Foreground="{StaticResource AccentWaitingBrush}" TextDecorations="Underline" />
                                    </Hyperlink>
                                    <Run Text=") for the Once Human community." Foreground="{StaticResource TextMutedBrush}" />
                                </TextBlock>

                                <Button Style="{StaticResource ModernDarkButtonStyle}"
                                        Click="OpenGitHub_Click"
                                        Content="{loc:Loc About_GitHub}"
                                        HorizontalAlignment="Left"
                                        Padding="14,6"
                                        Margin="0,0,0,16" />

                                <!-- Software Updates Section -->
                                <Border Background="#161B26" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Update_SectionTitle}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                            <Button Style="{StaticResource ModernDarkButtonStyle}"
                                                    Command="{Binding CheckForUpdatesCommand}"
                                                    Content="{loc:Loc Update_CheckButton}"
                                                    Padding="12,6"
                                                    Margin="0,0,12,0" />

                                            <TextBlock Text="{Binding UpdateStatusMessage}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="450" />
                                        </StackPanel>

                                        <!-- Update Available & Changelog Panel -->
                                        <Border Margin="0,8,0,0"
                                                Background="#1E2430"
                                                BorderBrush="{StaticResource AccentWaitingBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="12"
                                                Visibility="{Binding ShowUpdateAvailablePanel, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc Update_ReleaseNotes}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="{StaticResource AccentWaitingBrush}"
                                                           Margin="0,0,0,6" />

                                                <Border MaxHeight="140"
                                                        Background="#0B0F17"
                                                        BorderBrush="{StaticResource BorderDarkBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8"
                                                        Margin="0,0,0,10">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <TextBlock Text="{Binding ReleaseNotes}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="11"
                                                                   FontFamily="Consolas, monospace"
                                                                   TextWrapping="Wrap" />
                                                    </ScrollViewer>
                                                </Border>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource PrimaryAccentButtonStyle}"
                                                            Command="{Binding ApplyUpdateCommand}"
                                                            Content="{loc:Loc Update_DownloadAndApply}"
                                                            Padding="14,6"
                                                            Margin="0,0,12,0" />

                                                    <ProgressBar Width="180" Height="8"
                                                                 Minimum="0" Maximum="100"
                                                                 Value="{Binding UpdateDownloadProgress}"
                                                                 Foreground="{StaticResource AccentWaitingBrush}"
                                                                 Background="#0B0F17"
                                                                 BorderBrush="{StaticResource BorderDarkBrush}"
                                                                 Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Bottom Action Bar -->
            <Grid Grid.Row="2" Margin="16,10,16,14">
                <TextBlock Text="{loc:Loc Settings_SavedSuccess}"
                           Foreground="#22C55E"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Visibility="{Binding ShowSavedNotification, Converter={StaticResource BoolToVis}}" />

                <Button Style="{StaticResource PrimaryAccentButtonStyle}"
                        Command="{Binding SaveCommand}"
                        Content="{loc:Loc Settings_Save}"
                        HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Border>
</Window>
