<Window x:Class="OnceHumanEventTimer.UI.Tray.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tray Menu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="True">

    <Window.Resources>
        <Style x:Key="TrayMenuItemButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A2436"/>
                                <Setter Property="Foreground" Value="#00F0FF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A2436"/>
                                <Setter Property="Foreground" Value="#00F0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#121A28"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Background="#F50B0F17"
            BorderBrush="#333D4D"
            BorderThickness="1"
            CornerRadius="6"
            Padding="4"
            MinWidth="180">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Opacity="0.6"/>
        </Border.Effect>
        <StackPanel>
            <Button x:Name="BtnToggleVisibility"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="OnToggleVisibilityClick"/>

            <Button x:Name="BtnToggleLock"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="OnToggleLockClick"/>

            <Button x:Name="BtnPauseAlerts"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="OnPauseAlertsClick"/>

            <Button x:Name="BtnSettings"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="OnSettingsClick"/>

            <Border Height="1"
                    Background="#263142"
                    Margin="4,4"
                    SnapsToDevicePixels="True"/>

            <Button x:Name="BtnExit"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="OnExitClick"/>
        </StackPanel>
    </Border>
</Window>
